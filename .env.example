# Chaves de API para habilitar respostas reais de IA no MedInteract
# Habilite uma das duas chaves abaixo (ou ambas). O Gemini é o recomendado por padrão.

# Chave da API do Google Gemini (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=

# Chave da API do Anthropic Claude (obtenha em: https://console.anthropic.com/)
ANTHROPIC_API_KEY=
